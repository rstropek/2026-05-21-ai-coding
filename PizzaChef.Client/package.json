{
  "name": "pizza-chef.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "CI=true ng build --progress=false",
    "watch": "ng build --watch --configuration development",
    "test": "playwright test",
    "e2e": "playwright test",
    "generate:api": "openapi-ts -i http://localhost:5252/openapi/v1.json -o src/app/api-client -c @hey-api/client-angular"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@hey-api/openapi-ts": "^0.97.2",
    "@playwright/test": "^1.60.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
