root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# IDE-Style-Regeln im Build aktivieren (sonst nur suggestion)
dotnet_analyzer_diagnostic.category-Style.severity = warning

# Modernes C#: file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# 'var' ist im Projekt erlaubt - IDE0007/IDE0008 aus
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0008.severity = none

# Primary Constructor ist Stilfrage, hier nicht erzwungen
dotnet_diagnostic.IDE0290.severity = none

# Expression-Body vs Block-Body ist Stilfrage, beides ok
dotnet_diagnostic.IDE0021.severity = none
dotnet_diagnostic.IDE0022.severity = none

# "Expression value is never used" zu noisy bei Fluent-APIs
dotnet_diagnostic.IDE0058.severity = none

# IDE0005 (unused usings) braucht GenerateDocumentationFile - hier aus, dafuer CA-Rules
dotnet_diagnostic.IDE0005.severity = none

# ASP.NET Core hat keinen SynchronizationContext - ConfigureAwait unnoetig
dotnet_diagnostic.CA2007.severity = none

# Nullable ist aktiviert - explizite Null-Checks bei public APIs redundant
dotnet_diagnostic.CA1062.severity = none

[*Tests*.cs]
# xUnit-Konvention: Methodennamen mit Underscores (Methode_Szenario_Ergebnis)
dotnet_diagnostic.CA1707.severity = none
# Cleanup-Code in Dispose darf breit fangen
dotnet_diagnostic.CA1031.severity = none
